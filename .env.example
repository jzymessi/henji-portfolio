# Comma-separated brokers to enable: ibkr,longbridge
# Longbridge is optional and disabled by default.
PORTFOLIO_BROKERS=ibkr
BASE_CURRENCY=USD

# Local bridge
PORTFOLIO_BRIDGE_PORT=4318

# IBKR TWS / IB Gateway (read-only socket API)
IBKR_ACCOUNT_ID=
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=
IBKR_TWS_CLIENT_ID=71
IBKR_TWS_PYTHON=

# Longbridge official CLI. Add "longbridge" to PORTFOLIO_BROKERS to enable.
LONGBRIDGE_CLI=longbridge
LONGBRIDGE_REGION=global
